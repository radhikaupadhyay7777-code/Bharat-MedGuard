# BharatMedGuard Environment Configuration
PROJECT_NAME="BharatMedGuard AI Healthcare Cyber Defence"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration
# If MongoDB server is unavailable, the system automatically runs on embedded in-memory async store
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="bharatmedguard_db"

# Security & Authentication (JWT)
JWT_SECRET_KEY="bharatmedguard_secure_jwt_key_national_cyber_defence_2026"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_MINUTES=1440

# CORS Allowed Origins
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Uploads & Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15

# ML Hyperparameters
DEFAULT_CONTAMINATION=0.05
DEFAULT_ESTIMATORS=100
